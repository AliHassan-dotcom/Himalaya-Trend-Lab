# ============================================================================
# Himalaya Trend Lab - Environment Configuration
# Copy this file to `.env` and fill in your Meteomatics Global Offer credentials
# ============================================================================

# Meteomatics Weather API (HTTP Basic Auth credentials from email)
METEOMATICS_USERNAME=your_meteomatics_username
METEOMATICS_PASSWORD=your_meteomatics_password

# Optional: Default significance level (alpha)
DEFAULT_ALPHA=0.05

# Enable/Disable local disk caching (protects 1,000 queries/day quota)
ENABLE_CACHE=true
